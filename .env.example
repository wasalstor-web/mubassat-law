# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Supabase LAWSA
# Browser-safe values. The publishable key is intentionally usable by client code;
# database authorization is enforced by Supabase Auth + Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_URL=https://bzkjxxptdfpqmuwoxtjp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_bCJQeJOGVZkNnMbt5u1h3A_zUzdv-L9
SUPABASE_PROJECT_ID=bzkjxxptdfpqmuwoxtjp

# Server-only Supabase credentials. NEVER commit real values.
# Store them in GitHub: Settings > Secrets and variables > Actions.
SUPABASE_SECRET_KEY=****
SUPABASE_ACCESS_TOKEN=****
SUPABASE_DB_PASSWORD=****

# The following keys below are automatically created and
# added to your environment when you deploy on Vercel

# Instructions to create an AI Gateway API key here: https://vercel.com/ai-gateway
# API key required for non-Vercel deployments
# For Vercel deployments, OIDC tokens are used automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# Direct Anthropic API key (alternative to AI Gateway)
# Get yours at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=****

# Direct OpenAI API key (alternative to AI Gateway)
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=****

# Direct Google Generative AI key (for Gemini models)
# Get yours at https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=****

# Instructions to create a Vercel Blob Store here: https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Existing application database connection. Keep server-only.
POSTGRES_URL=****

# Instructions to create a Redis store here:
# https://vercel.com/docs/redis
REDIS_URL=****
